# All of these are read into nuxt.config.ts's `runtimeConfig` and baked
# into the server bundle at build time (not read from process.env per
# request) — see the comment there for why. On Amplify, that means these
# must be set as Console env vars BEFORE the build that deploys them; a
# value added after the last build won't take effect until the next one.

# Both URLs need ?schema=auroraapp: Aurora lives in its own Postgres schema, not `public`.
#
# Postgres — pooled connection. Used at runtime through the PrismaPg driver adapter
# (server/utils/prisma.ts).
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=auroraapp"

# Postgres — direct connection (no pooler). Used by the Prisma CLI for migrations only
# (prisma.config.ts), never at runtime.
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=auroraapp"

# Public origin of this app, e.g. https://app.example.com — used to rebuild
# the URL Twilio signed against (Amplify sits behind CloudFront, so the
# request URL seen by the handler isn't the public one) and must match the
# webhook URL configured in the Twilio console exactly.
PUBLIC_URL=

# Twilio (WhatsApp) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio WhatsApp-enabled sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Trigger.dev — used to call the `capture-agent` task in aurora-agents
TRIGGER_SECRET_KEY=

# Shared secret the capture-agent task presents (as `Bearer <secret>`) when
# calling this app's internal endpoints, e.g. /api/internal/notify. Generate
# with `openssl rand -hex 32`.
INTERNAL_API_SECRET=

# Vendor login, created by `npm run db:seed` (also run on every Amplify build, after
# migrations). Create-only: an existing vendor is never modified, so changing
# VENDOR_PASSWORD later does nothing unless you also set VENDOR_RESET_PASSWORD=1 for a run.
# Password must be at least 10 characters.
VENDOR_EMAIL=sahildavid.dev@gmail.com
VENDOR_PASSWORD=

# Google Maps JavaScript API browser key (home page map). Ships to the client, so restrict it
# by HTTP referrer in Google Cloud and limit it to the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=

# Google OAuth client (Web application) for "Connect Google" — imports Maps starred places via
# the Data Portability API. Enable that API in Google Cloud, then add an OAuth consent screen
# with the scope dataportability.maps.starred_places and these authorised redirect URIs:
#   <PUBLIC_URL>/api/google/callback   (e.g. http://localhost:3000/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Full callback URL; defaults to <PUBLIC_URL>/api/google/callback. Set it for local dev
# (http://localhost:3001/api/google/callback) when PUBLIC_URL is an ngrok tunnel.
GOOGLE_REDIRECT_URI=

# Encrypts the Google access token stored while an export is pending. Generate with
# `openssl rand -hex 32`; keep it stable per environment.
SECRET_ENCRYPTION_KEY=

# Optional. E.164 number (e.g. +447700900123) whose WhatsApp captures belong to this vendor.
# With a single vendor, captures from any number fall back to them.
VENDOR_WHATSAPP_NUMBER=

# Server-side Google key for the Geocoding API (fills each place's city / region / country).
# Create a separate key with API restriction = Geocoding API and NO website restriction —
# the browser Maps key is referrer-restricted and Google rejects it for server calls.
GOOGLE_GEOCODING_API_KEY=
